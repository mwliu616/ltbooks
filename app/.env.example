# ============================================================================
# LtBooks Ver 1.0 环境变量示例
# Copyright (c) 2026 LEDU TECH CO., LIMITED
# SPDX-License-Identifier: MIT
#
# 复制成 .env 再用：cp .env.example .env
# 注意：这些只是「首次部署的初始值」。模型密钥、SMTP、公司资料等，
#       部署后一律在「设置」页面维护（app_settings 表），界面改过就以界面为准。
# ============================================================================

# ---- 数据库（必填，无法在界面改）----
LEDU_DB_HOST=127.0.0.1
LEDU_DB_PORT=3306
LEDU_DB_NAME=ledu_accounting
LEDU_DB_USER=ledu_app
LEDU_DB_PASSWORD=change-me

# ---- 内置 API（前后端在同一台机器上）----
LEDU_API_HOST=127.0.0.1
LEDU_API_PORT=8099
# 前端调后端用的内部令牌，长度至少 32 位随机串
LEDU_API_TOKEN=change-me-to-a-long-random-token

# ---- 大模型（也可在「设置 → 大模型」填写，界面优先）----
LEDU_LLM_BASE=https://api.deepseek.com
LEDU_LLM_MODEL=deepseek-chat
LEDU_LLM_API_KEY=

# ---- OCR / 视觉识别（可选）----
LEDU_VISION_API_KEY=

# ---- 邮件（也可在「设置 → 邮件」填写，界面优先）----
LEDU_SMTP_HOST=
LEDU_SMTP_PORT=465
LEDU_SMTP_SECURE=ssl
LEDU_SMTP_USER=
LEDU_SMTP_PASSWORD=
LEDU_SMTP_FROM_NAME=LtBooks

# ---- 可移植部署路径（安装器会自动写入实际值）----
LEDU_WEB_ROOT=/var/www/ltbooks
LEDU_STORAGE_DIR=/opt/ltbooks/storage
LEDU_UPLOAD_DIR=/var/lib/ltbooks/uploads
LEDU_UPLOAD_DIRS=/var/lib/ltbooks/uploads:/opt/ltbooks/storage/uploads
LEDU_BACKUP_DIR=/var/backups/ltbooks
LEDU_BACKUP_KEEP=180
LEDU_BACKUP_LOCK=/opt/ltbooks/storage/backup.lock
LEDU_AGENT_PRESET=/opt/ltbooks/agent

# ---- 随包会计校验智能体使用的 Node 可执行文件 ----
LEDU_NODE_BIN=/usr/bin/node
